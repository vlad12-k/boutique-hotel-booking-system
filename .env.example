APP_ENV=development
SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=sqlite:///hotel.db
API_ADMIN_TOKEN=your_api_admin_token
NOTIFICATION_DELIVERY_ENABLED=0
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute
LOGIN_IP_RATE_LIMIT=20 per minute
API_RATE_LIMIT=30 per minute

# Initial owner bootstrap. Set these only for the bootstrap command, then unset.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Property Owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-long-random-password

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_housekeeping_chat_id
TELEGRAM_ALLOWED_CHAT_IDS=your_authorised_staff_chat_ids
TELEGRAM_POLL_INTERVAL_SECONDS=3

EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=hotel-system@example.com
EMAIL_TO=housekeeping@example.com
